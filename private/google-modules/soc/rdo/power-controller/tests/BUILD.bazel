"""Power controller power domain test suite definitions."""

load("@rules_cc//cc:defs.bzl", "cc_library")
load(
    "//private/devices/google/common/kleaf:bste.bzl",
    "bste_cc_binary",
    "bste_test_suite",
)
load("//private/google-modules/soc/rdo/common/tests/power:bste_platform_defs.bzl", "bste_platform")
load(":power-domain/platform/mbu/mbu_pd_defs.bzl", "MBU_PD_DEFS")

platform_defs = bste_platform.select(MBU_PD_DEFS)

# Exported helper library for controlling power domains via debugfs/mbfs
cc_library(
    name = "pd_control",
    srcs = [
        "power-domain/pd_control.c",
    ] + platform_defs.binary_srcs,
    hdrs = [
        "power-domain/pd_control.h",
        "power-domain/pd_defs.h",
    ],
    includes = ["power-domain"],
    visibility = ["//private/google-modules/soc/rdo:__subpackages__"],
    deps = [
        "//private/google-modules/soc/rdo/common/tests/power:bste_log",
        "//private/google-modules/soc/rdo/common/tests/power:fs_utils",
    ],
)

bste_cc_binary(
    name = "pd_test_runner",
    srcs = [
        "power-domain/pd_test_runner.c",
    ],
    deps = [
        ":pd_control",
        "//private/google-modules/soc/rdo/common/tests/power:bste_log",
    ],
)

bste_test_suite(
    name = "power_controller_power_domain_tests",
    srcs = platform_defs.suite_srcs,
    data = [
        ":pd_test_runner",
    ],
    test_cases = platform_defs.test_cases,
)

filegroup(
    name = "pd_test_suites",
    srcs = [
        ":power_controller_power_domain_tests",
    ],
    visibility = ["//private/devices/google:__subpackages__"],
)
