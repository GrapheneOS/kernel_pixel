build --flag_alias=use_prebuilt_fips140=//private/devices/google/common:use_prebuilt_fips140
build --flag_alias=nouse_prebuilt_fips140=no//private/devices/google/common:use_prebuilt_fips140

# Build GKI and FIPS from source.
# include unsafe header list
build --allow_ddk_unsafe_headers
build --user_ddk_unsafe_headers=//private/devices/google/common:user_ddk_unsafe_headers

# b/400799412: Optimize build time
build --experimental_optimize_ddk_config_actions

# Specifically disallow empty glob, which will be default on Android 17.
build --incompatible_disallow_empty_glob

# Do not keep sandbox directories to save millions of files in the out directory in trade of 5-7%
# longer build time.
# TODO: b/476893581 - Investigate whether to use --experimental_inmemory_sandbox_stashes instead.
build --noreuse_sandbox_directories

# Debug configs
import %workspace%/private/devices/google/common/debug/debug.bazelrc

# Factory build
build:factory --config=pixel_debug_common
build:factory --//private/devices/google/common:factory

# Testing build, enable gcov
build:testing --gcov
build:testing --config=pixel_debug_common

# Build 16k page size kernel
build:16k --page_size=16k
build:16k --nouse_prebuilt_fips140
